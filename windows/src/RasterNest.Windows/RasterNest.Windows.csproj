<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only services: screen and window capture, display/window lists, OCR (Windows.Media.Ocr)
       and the clipboard. Shared by rnest.exe and the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>RasterNest.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RasterNest.Core/RasterNest.Core.csproj" />
    <ProjectReference Include="../RasterNest.Render/RasterNest.Render.csproj" />
  </ItemGroup>
</Project>
