<Project Sdk="Microsoft.NET.Sdk">
  <!-- The rnest command-line tool for Windows: same commands, flags and JSON as the Mac/Linux rnest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>rnest</AssemblyName>
    <RootNamespace>RasterNest.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../assets/rasternest.ico')">../../assets/rasternest.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Publish as one self-contained exe for winget. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RasterNest.Core/RasterNest.Core.csproj" />
    <ProjectReference Include="../RasterNest.Render/RasterNest.Render.csproj" />
    <ProjectReference Include="../RasterNest.Windows/RasterNest.Windows.csproj" />
  </ItemGroup>
</Project>
