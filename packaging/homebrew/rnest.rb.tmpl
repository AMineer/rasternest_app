class Rnest < Formula
  desc "RasterNest command-line screen capture, OCR and export"
  homepage "https://rasternest.app"
  # macOS: universal binary. Linux builds override the URL below.
  url "https://github.com/{{REPO}}/releases/download/v{{VERSION}}/rnest-{{VERSION}}-macos-universal.tar.gz"
  sha256 "{{SHA_MACOS}}"
  license "MIT"

  on_linux do
    on_intel do
      url "https://github.com/{{REPO}}/releases/download/v{{VERSION}}/rnest-{{VERSION}}-linux-x86_64.tar.gz"
      sha256 "{{SHA_LINUX_X86_64}}"
    end
    on_arm do
      url "https://github.com/{{REPO}}/releases/download/v{{VERSION}}/rnest-{{VERSION}}-linux-aarch64.tar.gz"
      sha256 "{{SHA_LINUX_AARCH64}}"
    end
  end

  def install
    bin.install "rnest"
  end

  def caveats
    on_linux do
      <<~EOS
        rnest drives an installed screenshot tool. Install one of:
          Wayland: grim + slurp, gnome-screenshot, or spectacle
          X11:     maim + slop, scrot, or imagemagick
        Optional: wl-clipboard or xclip (--clipboard), tesseract (ocr).
      EOS
    end
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rnest --version")
  end
end
